# Configurações do Flandão (Assistente de IA da Prime Pintura)

# Chave de API do Google Gemini (obrigatória em produção). Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini (padrão estável: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Origens extras autorizadas no CORS (separadas por vírgula)
# Padrões já inclusos: https://pinturaprime.com.br, https://www.pinturaprime.com.br, http://localhost:8888
FLANDAO_ORIGENS_EXTRAS=

# Ativação do Flandão ("sim" para ativo, "nao" para desativar temporariamente o chat)
FLANDAO_ATIVO=sim
